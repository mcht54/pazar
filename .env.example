# Kopyala: cp .env.example .env  — gerçek anahtarları asla .env.example içine yazma, asla git'e ekleme.

ENV=development

# --- Veritabanı ---
DATABASE_URL=postgresql+psycopg://mchttasarim:mchttasarim@localhost:5432/mchttasarim_dev

# --- Redis (Celery broker + result backend + cache) ---
REDIS_URL=redis://localhost:6379/0

# --- Backend ---
API_SECRET_KEY=change-me-in-real-env
API_CORS_ORIGINS=http://localhost:3000

# --- AI Sağlayıcı ---
ANTHROPIC_API_KEY=

# --- Google Places API (New) ---
# https://developers.google.com/maps/documentation/places/web-service — ToS/kota koşullarına integrations/google_places/policy.py üzerinden uyulur
GOOGLE_PLACES_API_KEY=

# --- Google PageSpeed Insights API ---
GOOGLE_PAGESPEED_API_KEY=

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
