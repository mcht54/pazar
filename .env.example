# Kopyala: cp .env.example .env  — gerçek anahtarları asla .env.example içine yazma, asla git'e ekleme.

ENV=development

# --- Discovery sağlayıcısı ---
# google_maps = VARSAYILAN — Google Haritalar'dan (tarayıcıyla, herkese açık sayfa) GERÇEK işletme keşfi ve araştırması; API anahtarı gerekmez.
#               Kurulum: `pip install -r requirements.txt && playwright install chromium`
# google      = Google Places API (New) — GOOGLE_PLACES_API_KEY zorunlu (resmi API).
# mock        = SADECE test — kurgusal DEMO veri üretir, gerçek kullanımda ASLA seçilmemeli.
# (OpenStreetMap/Overpass artık kullanılmıyor; eski "osm" değeri otomatik olarak google_maps'e çevrilir.)
# Google Haritalar/Arama otomatik erişimi engelleyebilir (CAPTCHA); bu durumda kaynak ERİŞİLEMEDİ olarak gösterilir, engel aşılmaz.
DISCOVERY_PROVIDER=google_maps

# --- AI yorumlama sağlayıcısı ---
# none   = AI yorum/önceliklendirme aşaması atlanır (skipped); Finding/Rule Engine/Scoring etkilenmez
# claude = Claude API ile yorumlama — ANTHROPIC_API_KEY zorunlu
AI_PROVIDER=none

# --- Veritabanı ---
DATABASE_URL=postgresql+psycopg://mchttasarim:mchttasarim@localhost:5432/mchttasarim_dev

# --- Redis (Celery broker + result backend + cache) ---
REDIS_URL=redis://localhost:6379/0

# --- Backend ---
API_SECRET_KEY=change-me-in-real-env
API_CORS_ORIGINS=http://localhost:3000
# E-postadaki şifre belirleme/sıfırlama bağlantılarının adresi (arayüzün genel adresi)
WEB_BASE_URL=http://localhost:3000

# --- AI Sağlayıcı ---
ANTHROPIC_API_KEY=

# --- Çok kaynaklı araştırma (Google/Bing Haritalar, web sitesi) — testlerde otomatik kapatılır ---
RESEARCH_ENABLED=true

# --- Google Places API (New) — yalnızca DISCOVERY_PROVIDER=google iken ---
# https://developers.google.com/maps/documentation/places/web-service — ToS/kota koşullarına integrations/google_places/policy.py üzerinden uyulur
GOOGLE_PLACES_API_KEY=
# Son yorum tarihi için yorum alanı da istenir (daha pahalı SKU). Maliyeti düşürmek için false yapılabilir;
# bu durumda "son yorum tarihi" Doğrulanamadı olarak gösterilir.
GOOGLE_PLACES_FETCH_REVIEWS=true

# --- Google PageSpeed Insights API ---
# Boşsa sayfa hızı/mobil performans için Google PageSpeed KULLANILMAZ (anahtarsız kotası sıfırdır); sistem
# yaklaşık kendi ölçümünü ("yaklaşık ölçüm" etiketiyle) gösterir. Anahtar (ücretsiz) eklenirse gerçek mobil puan gelir.
GOOGLE_PAGESPEED_API_KEY=

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
