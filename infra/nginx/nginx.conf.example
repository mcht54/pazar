# Üretim VPS'i için taslak — Certbot ile SSL kurulumu ve gerçek domain
# tanımlandığında (deployment sprint'i) docker-compose'a bir `nginx` servisi
# olarak eklenecek. Sprint 0'da sadece referans amaçlıdır, henüz devrede değildir.

server {
    listen 80;
    server_name _;

    location /api/ {
        proxy_pass http://api:8000/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location / {
        proxy_pass http://web:3000/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }
}
